# Used by `npm run build`, i.e. the live GitHub Pages site.
# The live site is currently the UAT environment (Firebase project e-service-uat).
# When a real production project exists, put its values here and set VITE_APP_ENV=production.
VITE_APP_ENV=uat
# Starts with the standard forms only, never sample people or requests
VITE_SEED_SAMPLE_DATA=false
VITE_FIREBASE_API_KEY=AIzaSyDsCOqypAmjATN0qUni2qNik6B__L5FaDQ
VITE_FIREBASE_AUTH_DOMAIN=e-service-uat-e8402.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=e-service-uat-e8402
VITE_FIREBASE_STORAGE_BUCKET=e-service-uat-e8402.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=579778526613
VITE_FIREBASE_APP_ID=1:579778526613:web:0c850d22c7831d24ac0a9c
# Sign-in emails that may open system settings (comma-separated).
# Must match isAdmin() in the firestore.rules published to e-service-uat.
VITE_ADMIN_EMAILS=it_1@jmi.local