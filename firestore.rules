rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then press Publish.
//
// - Nobody can read or write anything without signing in.
// - Everyone signed in can read all data and
//   create / update requests and their notifications.
// - Anyone signed in can create a form (and its workflow) for their department;
//   only its creator or an admin can change or delete it afterwards.
// - Only the admin accounts listed in isAdmin() can change employees, the
//   original IT forms and their workflows, or delete requests.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin sign-in emails (accounts in Firebase Authentication). Keep in sync with
    // ADMIN_EMAILS in src/lib/firebase.ts.
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'it_1@jmi.local'
      ];
    }

    match /requests/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /employees/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Forms built by a department record who created them
    function createsAsSelf() {
      return signedIn() && request.resource.data.createdBy == request.auth.token.email;
    }
    function ownsExisting() {
      return signedIn() && resource.data.get('createdBy', '') == request.auth.token.email;
    }

    match /menuPermissions/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || createsAsSelf();
      allow update: if isAdmin() || (ownsExisting() && createsAsSelf());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /workflows/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || createsAsSelf();
      allow update: if isAdmin() || (ownsExisting() && createsAsSelf());
      allow delete: if isAdmin() || ownsExisting();
    }

    // Marker that the starting data has been loaded
    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
